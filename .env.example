# ────────────────────────────────────────────────────────────────────────────
# Environment template (scope §37). Copy to `.env.local` and fill in real
# values:  cp .env.example .env.local
#
# `.env.local` is gitignored and must stay that way. NEVER reuse production
# secrets in preview/development, and never expose server-only keys
# (SUPABASE_SERVICE_ROLE_KEY, AI provider keys) to the browser bundle.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API. NEXT_PUBLIC_* are inlined into the client bundle
# at build time — they must be the PUBLIC anon key, never the service role.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVER-ONLY: bypasses RLS. Used by server actions/routes and the e2e/diag
# scripts. Must never reach client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string — used by the Supabase CLI
# (`npm run db:migrate`, seeds). Optional for running the app itself.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── App ─────────────────────────────────────────────────────────────────────
# The origin users actually open the app on. Every emailed link (signup
# confirmation, approval notice, password recovery) is built from it, so in
# Supabase Auth → URL Configuration the allowlist must contain this origin
# plus /login and /reset-password — e.g. http://localhost:3000/login while
# developing. A wrong value here is the usual cause of "the email link
# doesn't work".
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI providers (server-side only; at least one required to generate) ──────
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
HUGGINGFACE_API_KEY=hf_...

# ── Identity verification (scope §5) ────────────────────────────────────────
# `mediapipe` = on-device face/liveness capture at /student/verify.
# Unset/anything else = faculty-authorized manual verification only.
IDENTITY_ADAPTER=mediapipe

# ── Optional / local development only ───────────────────────────────────────
# LAST RESORT for a network that intercepts TLS (corporate proxy, TLS-inspecting
# antivirus) and presents a CA Node does not trust. Prefer trusting that CA
# locally (`NODE_EXTRA_CA_CERTS=/path/to/corp-ca.pem`) — that keeps verification
# on. `NODE_TLS_REJECT_UNAUTHORIZED=0` turns certificate verification off for
# EVERY outbound request in the process, including service-role calls that
# carry the Supabase key, so it must never be set in a deployed environment
# (Vercel, Docker, CI). Node also prints a loud warning whenever it is set.
# NODE_TLS_REJECT_UNAUTHORIZED=0
# NODE_EXTRA_CA_CERTS=/path/to/your-ca.pem
